{
  "name": "strapi-plugin-bff-views",
  "version": "1.0.0",
  "description": "Configurable BFF aggregate endpoints for Strapi v5: one request returns a fully populated, transformed page payload backed by parallel decomposed queries.",
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "type-check": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p __tests__/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size-check": "node scripts/check-package-size.mjs",
    "prepublishOnly": "npm run size-check",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@strapi/sdk-plugin": "^6.0.1",
    "@strapi/strapi": "^5.0.0",
    "@strapi/types": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "name": "bff-views",
    "displayName": "BFF Views",
    "description": "Configurable BFF aggregate endpoints backed by parallel decomposed queries.",
    "kind": "plugin"
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "bff",
    "backend-for-frontend",
    "aggregate",
    "populate",
    "performance",
    "headless-cms"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jmichalec-vl/strapi-plugin-bff-views.git"
  },
  "homepage": "https://github.com/jmichalec-vl/strapi-plugin-bff-views#readme",
  "bugs": {
    "url": "https://github.com/jmichalec-vl/strapi-plugin-bff-views/issues"
  },
  "author": "jmichalec-vl",
  "files": [
    "dist",
    "server",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ]
}
